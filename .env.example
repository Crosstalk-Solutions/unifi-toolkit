# ============================================
# UniFi Toolkit Configuration
# ============================================
#
# IMPORTANT: Run ./setup.sh for guided configuration!
# The setup wizard will generate these values for you.
#
# ============================================

# ============================================
# DEPLOYMENT SETTINGS
# ============================================

# Deployment type: local or production
# - local: No authentication, access via http://localhost:8000
# - production: Authentication required, HTTPS via Caddy
DEPLOYMENT_TYPE=local

# The full hostname you type in the browser to reach the toolkit, such as
# toolkit.example.com (not just example.com). Production mode uses it for the
# HTTPS certificate, so it must point to this server's IP address for Let's
# Encrypt. Every mode also uses it to accept requests addressed to that name,
# so set it if you reach a local-mode toolkit through a reverse proxy.
DOMAIN=toolkit.yourdomain.com

# Extra hostnames to accept (anti-DNS-rebinding protection). Each entry must be
# the exact hostname in the browser's address bar: no wildcards, and
# example.com does not cover toolkit.example.com. This is checked against the
# Host header of each request, not the address it comes from, so a reverse
# proxy's IP does not belong here. IP addresses, localhost, local names
# (*.local/.lan/.internal/.home) and the DOMAIN above are always accepted.
# Set it (comma-separated) only if you reach the toolkit through another
# hostname, such as a Tailscale name (box.tailnet.ts.net) or a second
# reverse-proxy domain. Use "*" to turn the check off (not recommended).
# ALLOWED_HOSTS=box.tailnet.ts.net,unifi.example.net

# Admin credentials (production only)
# Generate with: ./setup.sh (interactive) or ./reset_password.sh
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=

# ============================================
# REQUIRED SETTINGS
# ============================================

# Encryption key for securing UniFi credentials stored in the database
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: Do not change this key after initial setup or encrypted data will be lost
ENCRYPTION_KEY=your-fernet-key-here

# ============================================
# DATABASE SETTINGS
# ============================================

# Database URL (default uses SQLite in data/ directory)
DATABASE_URL=sqlite+aiosqlite:///./data/unifi_toolkit.db

# ============================================
# LOGGING
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# UNIFI CONTROLLER
# ============================================
# UniFi controller credentials are configured through the WEB UI
# after first launch — not through environment variables.
#
# 1. Start the container
# 2. Open the dashboard in your browser
# 3. Enter your controller URL, credentials, and site ID
# 4. Click "Test Connection" then "Save"
#
# Credentials are encrypted at rest using the ENCRYPTION_KEY above.

# ============================================
# TOOL-SPECIFIC SETTINGS
# ============================================

# Wi-Fi Stalker: Device refresh interval in seconds
STALKER_REFRESH_INTERVAL=60

# ============================================
# ADVANCED SETTINGS
# ============================================

# Application port (local deployment only, default: 8000)
APP_PORT=8000
